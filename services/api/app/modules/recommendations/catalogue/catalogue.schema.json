{
  "$defs": {
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "enum": [
            "frontend",
            "backend",
            "database",
            "cache_queue",
            "auth",
            "hosting",
            "ci_cd",
            "observability",
            "integrations",
            "ai_layer"
          ],
          "title": "Category",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "project_fit": {
          "items": {
            "type": "string"
          },
          "title": "Project Fit",
          "type": "array"
        },
        "operational_complexity": {
          "enum": [
            "low",
            "medium",
            "high"
