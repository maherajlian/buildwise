          "type": "string"
        },
        "operational_burden": {
          "title": "Operational Burden",
          "type": "string"
        },
        "cost_category": {
          "enum": [
            "free-tier",
            "self-hosted",
            "usage-based",
            "paid",
            "open-source-self-hosted-or-managed"
